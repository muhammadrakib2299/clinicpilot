{
  "name": "clinicpilot",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS control plane to deploy, orchestrate, and monitor a fleet of healthcare AI agents.",
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "web": "pnpm --filter @clinicpilot/web dev",
    "api": "pnpm --filter @clinicpilot/api start:dev",
    "worker": "pnpm --filter @clinicpilot/api worker:dev",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:rls": "pnpm --filter @clinicpilot/api db:rls",
    "db:seed": "turbo run db:seed",
    "db:studio": "pnpm --filter @clinicpilot/api db:studio",
    "fhir:seed": "turbo run fhir:seed",
    "up:infra": "docker compose -f infra/docker-compose.yml --env-file .env up -d --wait postgres redis n8n",
    "up:all": "docker compose -f infra/docker-compose.yml --env-file .env up -d --build --wait",
    "down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "logs": "docker compose -f infra/docker-compose.yml --env-file .env logs -f",
    "test:integration": "pnpm --filter @clinicpilot/api test:integration",
    "n8n:import": "node scripts/n8n-import.mjs",
    "n8n:list": "docker compose -f infra/docker-compose.yml --env-file .env exec n8n n8n list:workflow"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
