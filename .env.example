# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Postgres (with pgvector) ─────────────────────────────────────────
POSTGRES_USER=clinicpilot
POSTGRES_PASSWORD=clinicpilot
POSTGRES_DB=clinicpilot
DATABASE_URL=postgresql://clinicpilot:clinicpilot@localhost:5432/clinicpilot

# ── Redis (cache + BullMQ queues) ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API gateway (NestJS) ─────────────────────────────────────────────
API_PORT=8080
JWT_SECRET=change-me-dev-only
WEB_ORIGIN=http://localhost:5173

# ── AI service (FastAPI) ─────────────────────────────────────────────
AI_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# ── LLM providers ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
OPENAI_API_KEY=                # optional fallback
LLM_PROVIDER=anthropic

# ── n8n (self-hosted automation) ─────────────────────────────────────
N8N_PORT=5678
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# ── FHIR ─────────────────────────────────────────────────────────────
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# ── Stripe (SaaS billing — TEST MODE only) ───────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxx

# ── Web (Vite) ───────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080
