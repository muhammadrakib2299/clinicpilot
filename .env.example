# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Host port mapping (docker compose) ───────────────────────────────
# Only the HOST side. Container ports are fixed. Override any of these if
# the port is already taken on your machine — compose reads them from your
# shell environment or from infra/.env.
POSTGRES_PORT=5432
REDIS_PORT=6379
N8N_PORT=5678
WEB_PORT=8081                  # containerised SPA (Vite dev server stays on 5173)

# ── Postgres (with pgvector) ─────────────────────────────────────────
POSTGRES_USER=clinicpilot
POSTGRES_PASSWORD=clinicpilot
POSTGRES_DB=clinicpilot
# The owning role: migrations, seeds, Drizzle Studio. A superuser under the
# official Postgres image.
DATABASE_URL=postgresql://clinicpilot:clinicpilot@localhost:5432/clinicpilot
# The role the running gateway connects as, created by `pnpm db:rls`.
# It MUST differ from the one above: superusers bypass row-level security
# silently, so using the owner here leaves every tenant policy unenforced.
# /api/health reports which one is in use.
APP_DATABASE_URL=postgresql://clinicpilot_app:clinicpilot_app_dev@localhost:5432/clinicpilot

# ── Redis (cache + BullMQ queues) ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API gateway (NestJS) ─────────────────────────────────────────────
API_PORT=8080
# Signs session tokens. The gateway refuses to boot without one, and refuses
# to boot with THIS one when NODE_ENV=production.
JWT_SECRET=change-me-dev-only
# Shared secret for the `internal/` surface (trace callbacks, FHIR access).
# Unset means those routes refuse every request, which is the safe default.
SERVICE_TOKEN=change-me-dev-only
WEB_ORIGIN=http://localhost:5173

# ── AI service (FastAPI) ─────────────────────────────────────────────
AI_PORT=8000
AI_SERVICE_URL=http://localhost:8000
# Where the AI service calls back to. Trace steps, task status and all FHIR
# access go through the gateway (ADR-004, ADR-008), so it needs the gateway's
# address — inside compose that is http://api:8080, not localhost.
API_URL=http://localhost:8080

# ── LLM providers ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
OPENAI_API_KEY=                # optional fallback
LLM_PROVIDER=anthropic

# ── n8n (self-hosted automation) ─────────────────────────────────────
N8N_PORT=5678
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# ── FHIR ─────────────────────────────────────────────────────────────
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# ── Stripe (SaaS billing — TEST MODE only) ───────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxx

# ── Web (Vite) ───────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080
